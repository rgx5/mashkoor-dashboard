# API settings for production. Copy to /var/www/mashkoor/mashkoor-dashboard/backend/.env on the server (never commit it), then fill in every blank.
NODE_ENV=production
PORT=4000
# Only nginx sits in front of the API on this server.
TRUST_PROXY_HOPS=1

# Same password as deploy/postgres/.env. The database is only reachable from this server.
DATABASE_URL=postgresql://mashkoor:PASTE_DB_PASSWORD@127.0.0.1:5432/mashkoor?schema=public

# The dashboard's public address; used in every emailed link and as the only allowed browser origin.
APP_URL=https://mashkoor.rapidrabbit.cloud
CORS_ORIGINS=https://mashkoor.rapidrabbit.cloud

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
TOKEN_PEPPER=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# 32 random bytes, base64. LOSING THIS KEY MAKES STORED PASSPORT NUMBERS UNREADABLE — keep a copy in the vault.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ─── Email (MSG91) ───────────────────────────────────────────────────────────
MAIL_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=Mashkoor Tourism
MSG91_EMAIL_TEMPLATE_ID=

# ─── Payments ────────────────────────────────────────────────────────────────
# The test gateway is forced off in production: online payments stay disabled until a real gateway is connected.
# Staff can still record offline payments.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=unused-in-production

# ─── Public website ──────────────────────────────────────────────────────────
# Where the API tells the website to refresh its cached pages (the website runs on this same server).
WEBSITE_URL=http://127.0.0.1:3000
# Must equal REVALIDATE_SECRET in the website's .env.production (at least 16 characters).
REVALIDATE_SECRET=

# ─── Uploaded documents (visas, tickets, vouchers) ────────────────────────────
# Stored on this server's disk, encrypted at rest with a key derived from FIELD_ENCRYPTION_KEY — never in Postgres.
# Must be an absolute path outside the app folder, owned by the app user, mode 700. Back this up (see backup.sh) and
# copy its contents (not just the database) if you ever move to another server.
UPLOAD_DIR=/var/lib/mashkoor/uploads
STORAGE_ENCRYPT=true

# ─── Feature flags ─────────────────────────────────────────────────────────────
# "all" turns on every optional module (the CRM core is always on regardless). To turn one off, list only the ones
# you want instead, e.g. "quotations,bookings,b2b,portal" (no "website") turns off website content and direct
# booking. See packages/shared/src/features.ts for the full list and which features require another one to be on.
ENABLED_FEATURES=all

# ─── First Super Admin (used once by `prisma db seed`) ───────────────────────
SEED_ADMIN_EMAIL=admin@mashkoor.co.in
SEED_ADMIN_PASSWORD=
