# Website settings for production. Copy to /var/www/mashkoor/mashkoor-website/.env.production on the server (never commit it).
# NEXT_PUBLIC_* values are baked into the pages when `next build` runs — change one, then redeploy the website.

# The website's public address (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.mashkoor.co.in
# The dashboard app's public address, for the "Agent Login" and "My Trips" links.
NEXT_PUBLIC_APP_URL=https://app.mashkoor.co.in
# Google Analytics 4 measurement ID (loads only after cookie consent). Optional.
NEXT_PUBLIC_GA_ID=

# The platform API on this same server (server-side calls only; the browser never sees it).
API_BASE_URL=http://127.0.0.1:4000
# Must equal REVALIDATE_SECRET in the dashboard backend's .env (at least 16 characters).
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REVALIDATE_SECRET=
