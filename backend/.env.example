NODE_ENV=development
PORT=4000

# Postgres from infra/compose/docker-compose.dev.yml
DATABASE_URL=postgresql://mashkoor:mashkoor@localhost:5433/mashkoor?schema=public

# Frontend origin (used in invite / reset links). In dev the Vite server proxies /api to the backend.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
TOKEN_PEPPER=change-me-to-another-long-random-string
# 32 random bytes, base64 — encrypts passport numbers. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Seed: first Super Admin
SEED_ADMIN_EMAIL=admin@mashkoor.co.in
SEED_ADMIN_PASSWORD=ChangeMe12345

# ─── Email (M12) ─────────────────────────────────────────────────────────────
# "console" logs emails instead of sending (default). Switch to "msg91" once the values below are filled in.
MAIL_PROVIDER=console
MSG91_AUTH_KEY=
# The email domain verified in MSG91 (Email → Domains), and a sender address on it.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=Mashkoor Tourism
# One generic MSG91 email template whose subject is ##subject## and whose body is ##body_html##.
MSG91_EMAIL_TEMPLATE_ID=
# Optional override of the MSG91 email endpoint (a default is built in).
# MSG91_EMAIL_API_URL=

# ─── Payments (M11) ──────────────────────────────────────────────────────────
# Only the mock gateway exists until the client picks a real one.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=mock-gateway-secret-change-me

# ─── Public website (optional) ───────────────────────────────────────────────
# When both are set, editing packages/destinations/testimonials in the dashboard refreshes the website immediately.
# The website needs the same REVALIDATE_SECRET in its own .env. Leave empty to rely on its 5-minute cache.
WEBSITE_URL=
REVALIDATE_SECRET=
